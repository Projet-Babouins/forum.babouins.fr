---
// Zone de saisie d'un message. Deux modes sur le même texte Markdown :
// - « Visuel » : Milkdown Crepe, l'éditeur façon traitement de texte de la doc (/admin) ;
// - « Markdown » : le texte brut.
// La zone de texte reste le champ envoyé : sans JavaScript, le formulaire fonctionne quand même.
interface Props {
	name?: string;
	value?: string;
	label: string;
	placeholder?: string;
	required?: boolean;
	rows?: number;
	minlength?: number;
}

const { name = 'body', value = '', label, placeholder, required = true, rows = 8, minlength = 10 } = Astro.props;
const id = `composer-${Math.random().toString(36).slice(2, 8)}`;
---

<forum-composer class="composer">
	<div class="bar">
		<label for={id}>{label}</label>
		<div class="tabs" hidden>
			<button type="button" class="tab" data-mode="visual" aria-pressed="true">Visuel</button>
			<button type="button" class="tab" data-mode="source" aria-pressed="false">Markdown</button>
		</div>
	</div>
	<textarea {id} {name} {rows} {placeholder} {required} {minlength} maxlength="20000">{value}</textarea>
	<div class="editor" hidden style={`--rows: ${rows}`}></div>
	<p class="alert" role="alert" hidden></p>
	<small class="muted">
		Markdown accepté : <code>`code`</code>, blocs <code>```bash</code>, <strong>**gras**</strong>, listes, liens.
		Pas d'information d'entreprise (IP, noms internes, identifiants).
	</small>
</forum-composer>

<script>
	// Crepe écrit `<br />` pour chaque ligne vide laissée dans le texte : on les retire.
	const clean = (markdown: string) => markdown.replace(/^<br\s*\/?>\s*$/gm, '').replace(/\n{3,}/g, '\n\n').trim();

	class ForumComposer extends HTMLElement {
		connectedCallback() {
			const textarea = this.querySelector('textarea')!;
			const host = this.querySelector<HTMLElement>('.editor')!;
			const tabs = this.querySelector<HTMLElement>('.tabs')!;
			const alert = this.querySelector<HTMLElement>('.alert')!;
			let crepe: import('@milkdown/crepe').Crepe | undefined;

			const sync = () => {
				alert.hidden = true;
				textarea.setCustomValidity('');
				if (!crepe) return;
				textarea.value = clean(crepe.getMarkdown());
				// Le navigateur ne vérifie `minlength` que pour un texte tapé dans le champ lui-même.
				const length = textarea.value.length;
				if (length && length < textarea.minLength)
					textarea.setCustomValidity(`Au moins ${textarea.minLength} caractères (actuellement ${length}).`);
			};

			const mountVisual = async () => {
				const { Crepe } = await import('@milkdown/crepe');
				await import('@milkdown/crepe/theme/common/style.css');
				crepe = new Crepe({
					root: host,
					defaultValue: textarea.value,
					features: {
						[Crepe.Feature.TopBar]: true,
						[Crepe.Feature.Latex]: false,
						[Crepe.Feature.ImageBlock]: false, // pas d'envoi d'images sur le forum
					},
					featureConfigs: {
						[Crepe.Feature.Placeholder]: { text: textarea.placeholder || 'Écris ici… Tape « / » pour insérer un bloc.' },
						[Crepe.Feature.TopBar]: {
							headingOptions: [
								{ label: 'Paragraphe', level: null },
								{ label: 'Titre', level: 3 },
								{ label: 'Sous-titre', level: 4 },
							],
						},
						[Crepe.Feature.BlockEdit]: {
							textGroup: {
								label: 'Texte',
								text: { label: 'Paragraphe' },
								h1: null,
								h2: null,
								h3: { label: 'Titre' },
								h4: { label: 'Sous-titre' },
								h5: null,
								h6: null,
								quote: { label: 'Citation' },
								divider: { label: 'Séparateur' },
							},
							listGroup: {
								label: 'Listes',
								bulletList: { label: 'Liste à puces' },
								orderedList: { label: 'Liste numérotée' },
								taskList: { label: 'Liste de tâches' },
							},
							advancedGroup: {
								label: 'Blocs',
								image: null,
								codeBlock: { label: 'Bloc de code' },
								table: { label: 'Tableau' },
							},
						},
						[Crepe.Feature.CodeMirror]: {
							searchPlaceholder: 'Chercher un langage',
							noResultText: 'Aucun résultat',
							copyText: 'Copier',
						},
					},
				});
				await crepe.create();
				crepe.on((listener) => listener.markdownUpdated(sync)); // boutons de la barre d'outils
			};

			const setMode = async (mode: string) => {
				for (const button of tabs.querySelectorAll('button')) button.setAttribute('aria-pressed', String(button.dataset.mode === mode));
				sync();
				await crepe?.destroy();
				crepe = undefined;
				textarea.setCustomValidity(''); // en mode Markdown, le navigateur vérifie lui-même
				host.replaceChildren();
				const visual = mode === 'visual';
				textarea.hidden = visual;
				host.hidden = !visual;
				if (visual) {
					await mountVisual();
					host.querySelector<HTMLElement>('.ProseMirror')?.focus();
				} else textarea.focus();
			};

			// markdownUpdated arrive avec un léger retard : on recopie aussi à chaque frappe,
			// pour que Ctrl+Entrée envoie bien le dernier caractère tapé.
			host.addEventListener('input', () => setTimeout(sync));

			// En mode visuel, la zone de texte est cachée : le navigateur ne peut pas y afficher
			// son message d'erreur (trop court, vide…). On l'affiche sous l'éditeur.
			textarea.addEventListener('invalid', (event) => {
				if (!textarea.hidden) return;
				event.preventDefault();
				alert.textContent = textarea.validationMessage;
				alert.hidden = false;
				host.querySelector<HTMLElement>('.ProseMirror')?.focus();
			});

			tabs.addEventListener('click', (event) => {
				const button = (event.target as HTMLElement).closest('button');
				if (button?.dataset.mode && button.getAttribute('aria-pressed') !== 'true') void setMode(button.dataset.mode);
			});

			// L'éditeur n'est chargé qu'une fois visible : un sujet peut avoir un formulaire
			// de réponse replié sous chaque message.
			new IntersectionObserver((entries, observer) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				observer.disconnect();
				tabs.hidden = false;
				textarea.hidden = true;
				host.hidden = false;
				mountVisual().catch(() => {
					// Éditeur indisponible : on garde la zone de texte.
					tabs.hidden = true;
					textarea.hidden = false;
					host.hidden = true;
				});
			}).observe(this);
		}
	}
	customElements.define('forum-composer', ForumComposer);
</script>

<style>
	.composer {
		display: grid;
		gap: var(--space-xs);
	}

	.bar {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: var(--space-sm);
	}

	label {
		font-weight: 600;
	}

	.tabs {
		display: flex;
		gap: 2px;
	}

	.tab {
		padding: 0.2rem 0.7rem;
		background: none;
		color: var(--color-text-muted);
		border: var(--rule);
		border-radius: var(--radius-sm);
		font: inherit;
		font-size: var(--text-sm);
		cursor: pointer;
	}

	.tab[aria-pressed='true'] {
		background: var(--color-bg-alt);
		color: var(--color-ink);
		font-weight: 600;
	}

	.alert {
		margin: 0;
		color: var(--color-danger);
		font-size: var(--text-sm);
	}

	/* Éditeur visuel (Milkdown Crepe) : couleurs branchées sur le thème du forum. */
	.editor {
		border: var(--rule);
		border-radius: var(--radius);
		background: var(--color-surface);
	}

	.editor:focus-within {
		outline: 2px solid var(--color-focus);
		outline-offset: 1px;
	}

	.editor :global(.milkdown) {
		--crepe-color-background: var(--color-surface);
		--crepe-color-on-background: var(--color-ink);
		--crepe-color-surface: var(--color-surface);
		--crepe-color-surface-low: var(--color-bg-alt);
		--crepe-color-on-surface: var(--color-ink);
		--crepe-color-on-surface-variant: var(--color-text-muted);
		--crepe-color-outline: var(--color-rule);
		--crepe-color-primary: var(--color-accent);
		--crepe-color-secondary: var(--color-bg-alt);
		--crepe-color-on-secondary: var(--color-ink);
		--crepe-color-inverse: var(--color-ink);
		--crepe-color-on-inverse: var(--color-surface);
		--crepe-color-inline-code: var(--color-accent);
		--crepe-color-error: var(--color-danger);
		--crepe-color-hover: var(--color-bg-alt);
		--crepe-color-selected: var(--color-bg-alt);
		--crepe-color-inline-area: var(--color-bg-alt);
		--crepe-base-font-size: var(--text-base);
		--crepe-font-title: var(--font-title);
		--crepe-font-default: var(--font-sans);
		--crepe-font-code: var(--font-mono);
		border-radius: var(--radius);
	}

	.editor :global(.milkdown-top-bar) {
		border-radius: var(--radius) var(--radius) 0 0;
	}

	.editor :global(.milkdown .ProseMirror) {
		min-height: calc(var(--rows) * 1.6em);
		padding: var(--space-md) var(--space-lg) var(--space-md) 3.5rem;
		outline: none;
	}

	code {
		font-family: var(--font-mono);
	}
</style>
